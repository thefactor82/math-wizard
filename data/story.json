        ],
        "dialogues": [
          { "who": "player", "frame": 0, "text": "Eccomi, mio Re!" },
          { "who": "re", "frame": 0, "text": "Benarrivat-o-a- al castello, NOMEPROFILOINUSO!" },
          { "who": "re", "frame": 0, "text": "Spero che gli Hop non ti abbiano causato troppi problemi." },
          { "who": "player", "frame": 0, "text": "Qualcuno, mio Re. E stanno diventando via via più fastidiosi..." },
          { "who": "re", "frame": 0, "text": "Ed è proprio per questo che ti ho mandat-o-a- a chiamare!" },
          { "who": "re", "frame": 0, "text": "I tuoi poteri magici potrebbero aiutarci a tenere a bada gli Hop!" },
          { "who": "re", "frame": 0, "text": "Più avanti lungo il sentiero, troverai l'ingresso di una caverna..." },
          { "who": "re", "frame": 0, "text": "Al fondo della caverna è custodito un magico ciondolo." },
          { "who": "re", "frame": 0, "text": "Và! E recuperalo per il tuo Re!" },
          { "who": "re", "frame": 0, "text": "Ma bada bene, gli Hop non te lo lasceranno prendere tanto facilmente..." },
          { "who": "re", "frame": 0, "text": "Mi raccomando. Resta concentrat-o-a-!" },
          { "who": "player", "frame": 0, "text": "A cosa servirà quel ciondolo?" },
          { "who": "re", "frame": 0, "text": "Lo scoprirai a tempo debito, ora vai!" },
          { "who": "player", "frame": 0, "text": "Farò del mio meglio, mio Re!" }
        ]
      }
